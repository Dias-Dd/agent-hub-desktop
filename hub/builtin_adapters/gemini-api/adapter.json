{
  "version": 1,
  "id": "gemini-api",
  "name": "Gemini API",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "efforts": [
    "default"
  ],
  "api": {
    "base_url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "key_environment": "GEMINI_API_KEY"
  },
  "provider": "gemini-api",
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "setup": {
    "website": "https://aistudio.google.com/",
    "login_url": "https://aistudio.google.com/apikey",
    "key_env": "GEMINI_API_KEY",
    "note": "在 AI Studio 创建 API 密钥，并配置 GEMINI_API_KEY 用户环境变量。"
  }
}
