{
  "version": 1,
  "id": "opencode-fluxa-token-plan",
  "name": "OpenCode【FluxA Token Plan】",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "provider": "opencode",
  "efforts": [
    "default"
  ],
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "quota_supported": false,
  "configuration": {
    "version": 1,
    "id": "opencode-provider-v1",
    "title": "供应商配置",
    "fields": [
      {
        "name": "variant",
        "type": "select",
        "label": "地区 / 套餐",
        "default": "v1",
        "options": [
          {
            "value": "v1",
            "label": "FluxA Token Plan",
            "defaults": {
              "base_url": "https://api.baiduqianfan.ai/v2/tokenplan/team",
              "models": []
            }
          }
        ]
      },
      {
        "name": "base_url",
        "type": "url",
        "label": "服务地址",
        "default": "https://api.baiduqianfan.ai/v2/tokenplan/team"
      },
      {
        "name": "api_key",
        "type": "secret",
        "label": "API Key",
        "placeholder": "留空保留已保存密钥"
      },
      {
        "name": "key_env",
        "type": "text",
        "label": "或使用密钥环境变量"
      },
      {
        "name": "models",
        "type": "string_list",
        "label": "模型 ID（可选，逗号分隔；留空使用预设）"
      }
    ]
  },
  "setup": {
    "website": "https://opencode.ai/",
    "note": "独立 OpenCode 供应商配置；在主程序添加 Agent 界面填写本供应商凭据，不复用原版账号。首次引导可先跳过。"
  },
  "settings": {
    "opencode_preset": {
      "id": "opencode-fluxa-token-plan",
      "name": "FluxA Token Plan",
      "variants": [
        {
          "id": "v1",
          "name": "FluxA Token Plan",
          "website": "https://agentmarket.fluxapay.xyz/",
          "npm": "@ai-sdk/openai-compatible",
          "config": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "FluxA Token Plan",
            "options": {
              "baseURL": "https://api.baiduqianfan.ai/v2/tokenplan/team",
              "apiKey": ""
            },
            "models": {
              "deepseek-v4-flash-0731": {
                "name": "DeepSeek V4 Flash 0731",
                "reasoning": true
              },
              "deepseek-v4-flash": {
                "name": "DeepSeek V4 Flash",
                "reasoning": true
              },
              "deepseek-v3.2": {
                "name": "DeepSeek V3.2"
              },
              "glm-5.2": {
                "name": "GLM-5.2",
                "reasoning": true
              },
              "glm-5.1": {
                "name": "GLM-5.1",
                "reasoning": true
              },
              "glm-5": {
                "name": "GLM-5",
                "reasoning": true
              },
              "kimi-k2.6": {
                "name": "Kimi K2.6",
                "reasoning": true
              }
            }
          }
        }
      ],
      "category": "aggregator"
    }
  },
  "source": {
    "repository": "https://github.com/farion1231/cc-switch",
    "commit": "88c878ac9da1d89ec1b512f87b52f3641dd30e3c",
    "license": "MIT"
  }
}
