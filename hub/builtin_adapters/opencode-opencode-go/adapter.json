{
  "version": 1,
  "id": "opencode-opencode-go",
  "name": "OpenCode【OpenCode Go】",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "provider": "opencode",
  "efforts": [
    "default"
  ],
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "quota_supported": false,
  "configuration": {
    "version": 1,
    "id": "opencode-provider-v1",
    "title": "供应商配置",
    "fields": [
      {
        "name": "variant",
        "type": "select",
        "label": "地区 / 套餐",
        "default": "v1",
        "options": [
          {
            "value": "v1",
            "label": "OpenCode Go",
            "defaults": {
              "base_url": "https://opencode.ai/zen/go/v1",
              "models": []
            }
          }
        ]
      },
      {
        "name": "base_url",
        "type": "url",
        "label": "服务地址",
        "default": "https://opencode.ai/zen/go/v1"
      },
      {
        "name": "api_key",
        "type": "secret",
        "label": "API Key",
        "placeholder": "留空保留已保存密钥"
      },
      {
        "name": "key_env",
        "type": "text",
        "label": "或使用密钥环境变量"
      },
      {
        "name": "models",
        "type": "string_list",
        "label": "模型 ID（可选，逗号分隔；留空使用预设）"
      }
    ]
  },
  "setup": {
    "website": "https://opencode.ai/",
    "note": "独立 OpenCode 供应商配置；在主程序添加 Agent 界面填写本供应商凭据，不复用原版账号。首次引导可先跳过。"
  },
  "settings": {
    "opencode_preset": {
      "id": "opencode-opencode-go",
      "name": "OpenCode Go",
      "variants": [
        {
          "id": "v1",
          "name": "OpenCode Go",
          "website": "https://opencode.ai/go",
          "npm": "@ai-sdk/openai-compatible",
          "config": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "OpenCode Go",
            "options": {
              "baseURL": "https://opencode.ai/zen/go/v1",
              "apiKey": "",
              "setCacheKey": true
            },
            "models": {
              "glm-5.3": {
                "name": "GLM 5.3",
                "reasoning": true
              },
              "glm-5.3-flash": {
                "name": "GLM 5.3 Flash",
                "reasoning": true
              },
              "kimi-k3.1-pro": {
                "name": "Kimi K3.1 Pro",
                "reasoning": true
              },
              "deepseek-v4.1-flash": {
                "name": "DeepSeek V4.1 Flash",
                "reasoning": true
              },
              "mimo-v2.6-pro": {
                "name": "MiMo V2.6 Pro",
                "reasoning": true
              }
            }
          }
        }
      ],
      "category": "third_party"
    }
  },
  "source": {
    "repository": "https://github.com/farion1231/cc-switch",
    "commit": "88c878ac9da1d89ec1b512f87b52f3641dd30e3c",
    "license": "MIT"
  }
}
