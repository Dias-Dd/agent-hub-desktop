{
  "version": 1,
  "id": "opencode-aicodemirror",
  "name": "OpenCode【AICodeMirror】",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "provider": "opencode",
  "efforts": [
    "default"
  ],
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "quota_supported": false,
  "configuration": {
    "version": 1,
    "id": "opencode-provider-v1",
    "title": "供应商配置",
    "fields": [
      {
        "name": "variant",
        "type": "select",
        "label": "地区 / 套餐",
        "default": "v1",
        "options": [
          {
            "value": "v1",
            "label": "AICodeMirror",
            "defaults": {
              "base_url": "https://api.aicodemirror.ai/api/claudecode",
              "models": []
            }
          }
        ]
      },
      {
        "name": "base_url",
        "type": "url",
        "label": "服务地址",
        "default": "https://api.aicodemirror.ai/api/claudecode"
      },
      {
        "name": "api_key",
        "type": "secret",
        "label": "API Key",
        "placeholder": "留空保留已保存密钥"
      },
      {
        "name": "key_env",
        "type": "text",
        "label": "或使用密钥环境变量"
      },
      {
        "name": "models",
        "type": "string_list",
        "label": "模型 ID（可选，逗号分隔；留空使用预设）"
      }
    ]
  },
  "setup": {
    "website": "https://opencode.ai/",
    "note": "独立 OpenCode 供应商配置；在主程序添加 Agent 界面填写本供应商凭据，不复用原版账号。首次引导可先跳过。"
  },
  "settings": {
    "opencode_preset": {
      "id": "opencode-aicodemirror",
      "name": "AICodeMirror",
      "variants": [
        {
          "id": "v1",
          "name": "AICodeMirror",
          "website": "https://www.aicodemirror.ai",
          "npm": "@ai-sdk/anthropic",
          "config": {
            "npm": "@ai-sdk/anthropic",
            "name": "AICodeMirror",
            "options": {
              "baseURL": "https://api.aicodemirror.ai/api/claudecode",
              "apiKey": "",
              "setCacheKey": true
            },
            "models": {
              "claude-sonnet-5-5": {
                "name": "Claude Sonnet 5.5",
                "reasoning": true
              },
              "claude-opus-5-5": {
                "name": "Claude Opus 5.5",
                "reasoning": true
              }
            }
          }
        }
      ],
      "category": "third_party"
    }
  },
  "source": {
    "repository": "https://github.com/farion1231/cc-switch",
    "commit": "88c878ac9da1d89ec1b512f87b52f3641dd30e3c",
    "license": "MIT"
  }
}
