{
  "version": 1,
  "id": "opencode-qianwen",
  "name": "OpenCode【千问AI平台】",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "provider": "opencode",
  "efforts": [
    "default"
  ],
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "quota_supported": false,
  "configuration": {
    "version": 1,
    "id": "opencode-provider-v1",
    "title": "供应商配置",
    "fields": [
      {
        "name": "variant",
        "type": "select",
        "label": "地区 / 套餐",
        "default": "v1",
        "options": [
          {
            "value": "v1",
            "label": "千问AI平台",
            "defaults": {
              "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
              "models": []
            }
          },
          {
            "value": "v2",
            "label": "千问AI平台 Token Plan",
            "defaults": {
              "base_url": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic/v1",
              "models": []
            }
          }
        ]
      },
      {
        "name": "base_url",
        "type": "url",
        "label": "服务地址",
        "default": "https://dashscope.aliyuncs.com/compatible-mode/v1"
      },
      {
        "name": "api_key",
        "type": "secret",
        "label": "API Key",
        "placeholder": "留空保留已保存密钥"
      },
      {
        "name": "key_env",
        "type": "text",
        "label": "或使用密钥环境变量"
      },
      {
        "name": "models",
        "type": "string_list",
        "label": "模型 ID（可选，逗号分隔；留空使用预设）"
      }
    ]
  },
  "setup": {
    "website": "https://opencode.ai/",
    "note": "独立 OpenCode 供应商配置；在主程序添加 Agent 界面填写本供应商凭据，不复用原版账号。首次引导可先跳过。"
  },
  "settings": {
    "opencode_preset": {
      "id": "opencode-qianwen",
      "name": "千问AI平台",
      "variants": [
        {
          "id": "v1",
          "name": "千问AI平台",
          "website": "https://platform.qianwenai.com/",
          "npm": "@ai-sdk/openai-compatible",
          "config": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "千问AI平台",
            "options": {
              "baseURL": "https://dashscope.aliyuncs.com/compatible-mode/v1",
              "apiKey": "",
              "setCacheKey": true
            },
            "models": {
              "qwen3.8-max": {
                "name": "Qwen3.8 Max",
                "reasoning": true,
                "limit": {
                  "context": 983616,
                  "output": 131072
                },
                "modalities": {
                  "input": [
                    "text",
                    "image",
                    "video"
                  ],
                  "output": [
                    "text"
                  ]
                }
              },
              "qwen3.8-flash": {
                "name": "Qwen3.8 Flash",
                "reasoning": true,
                "limit": {
                  "context": 983616,
                  "output": 131072
                },
                "modalities": {
                  "input": [
                    "text",
                    "image",
                    "video"
                  ],
                  "output": [
                    "text"
                  ]
                }
              }
            }
          }
        },
        {
          "id": "v2",
          "name": "千问AI平台 Token Plan",
          "website": "https://platform.qianwenai.com/pricing/token-plan",
          "npm": "@ai-sdk/anthropic",
          "config": {
            "npm": "@ai-sdk/anthropic",
            "name": "千问AI平台 Token Plan",
            "options": {
              "baseURL": "https://token-plan.cn-beijing.maas.aliyuncs.com/apps/anthropic/v1",
              "apiKey": "",
              "setCacheKey": true
            },
            "models": {
              "qwen3.8-max": {
                "name": "Qwen3.8 Max",
                "reasoning": true,
                "limit": {
                  "context": 983616,
                  "output": 131072
                },
                "modalities": {
                  "input": [
                    "text",
                    "image",
                    "video"
                  ],
                  "output": [
                    "text"
                  ]
                }
              },
              "qwen3.8-flash": {
                "name": "Qwen3.8 Flash",
                "reasoning": true,
                "limit": {
                  "context": 983616,
                  "output": 131072
                },
                "modalities": {
                  "input": [
                    "text",
                    "image",
                    "video"
                  ],
                  "output": [
                    "text"
                  ]
                }
              }
            }
          }
        }
      ],
      "category": "cn_official"
    }
  },
  "source": {
    "repository": "https://github.com/farion1231/cc-switch",
    "commit": "88c878ac9da1d89ec1b512f87b52f3641dd30e3c",
    "license": "MIT"
  }
}
