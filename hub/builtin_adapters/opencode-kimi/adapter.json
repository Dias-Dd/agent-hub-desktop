{
  "version": 1,
  "id": "opencode-kimi",
  "name": "OpenCode【Kimi】",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "provider": "opencode",
  "efforts": [
    "default"
  ],
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "quota_supported": false,
  "configuration": {
    "version": 1,
    "id": "opencode-provider-v1",
    "title": "供应商配置",
    "fields": [
      {
        "name": "variant",
        "type": "select",
        "label": "地区 / 套餐",
        "default": "v1",
        "options": [
          {
            "value": "v1",
            "label": "Kimi",
            "defaults": {
              "base_url": "https://api.moonshot.cn/v1",
              "models": []
            }
          },
          {
            "value": "v2",
            "label": "Kimi Global",
            "defaults": {
              "base_url": "https://api.moonshot.ai/v1",
              "models": []
            }
          },
          {
            "value": "v3",
            "label": "Kimi For Coding",
            "defaults": {
              "base_url": "https://api.kimi.com/coding/v1",
              "models": []
            }
          },
          {
            "value": "v4",
            "label": "Kimi For Coding Global",
            "defaults": {
              "base_url": "https://api.kimi.ai/coding/v1",
              "models": []
            }
          }
        ]
      },
      {
        "name": "base_url",
        "type": "url",
        "label": "服务地址",
        "default": "https://api.moonshot.cn/v1"
      },
      {
        "name": "api_key",
        "type": "secret",
        "label": "API Key",
        "placeholder": "留空保留已保存密钥"
      },
      {
        "name": "key_env",
        "type": "text",
        "label": "或使用密钥环境变量"
      },
      {
        "name": "models",
        "type": "string_list",
        "label": "模型 ID（可选，逗号分隔；留空使用预设）"
      }
    ]
  },
  "setup": {
    "website": "https://opencode.ai/",
    "note": "独立 OpenCode 供应商配置；在主程序添加 Agent 界面填写本供应商凭据，不复用原版账号。首次引导可先跳过。"
  },
  "settings": {
    "opencode_preset": {
      "id": "opencode-kimi",
      "name": "Kimi",
      "variants": [
        {
          "id": "v1",
          "name": "Kimi",
          "website": "https://platform.kimi.com",
          "npm": "@ai-sdk/openai-compatible",
          "config": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "Kimi",
            "options": {
              "baseURL": "https://api.moonshot.cn/v1",
              "apiKey": "",
              "setCacheKey": true
            },
            "models": {
              "kimi-k2.7-code": {
                "name": "Kimi K2.7 Code",
                "reasoning": true
              },
              "kimi-k3": {
                "name": "Kimi K3",
                "reasoning": true
              },
              "kimi-k2.7-code-highspeed": {
                "name": "Kimi K2.7 Code HighSpeed",
                "reasoning": true,
                "limit": {
                  "context": 262144,
                  "output": 262144
                },
                "modalities": {
                  "input": [
                    "text",
                    "image"
                  ],
                  "output": [
                    "text"
                  ]
                }
              },
              "kimi-k2.6": {
                "name": "Kimi K2.6",
                "reasoning": true,
                "limit": {
                  "context": 262144,
