{
  "version": 1,
  "id": "opencode-tencent",
  "name": "OpenCode【腾讯云】",
  "protocol": "hub-module-v1",
  "entrypoint": "adapter.py",
  "provider": "opencode",
  "efforts": [
    "default"
  ],
  "capabilities": {
    "tools": true,
    "resume": true,
    "streaming": true
  },
  "quota_supported": false,
  "configuration": {
    "version": 1,
    "id": "opencode-provider-v1",
    "title": "供应商配置",
    "fields": [
      {
        "name": "variant",
        "type": "select",
        "label": "地区 / 套餐",
        "default": "v1",
        "options": [
          {
            "value": "v1",
            "label": "Tencent Token Plan",
            "defaults": {
              "base_url": "https://api.lkeap.cloud.tencent.com/plan/v3",
              "models": []
            }
          },
          {
            "value": "v2",
            "label": "Tencent Token Plan (Intl)",
            "defaults": {
              "base_url": "https://tokenhub-intl.tencentcloudmaas.com/plan/v3",
              "models": []
            }
          },
          {
            "value": "v3",
            "label": "Tencent Token Plan Enterprise Pro",
            "defaults": {
              "base_url": "https://tokenhub.tencentmaas.com/plan/v3",
              "models": []
            }
          },
          {
            "value": "v4",
            "label": "Tencent Token Plan Enterprise Pro (Intl)",
            "defaults": {
              "base_url": "https://tokenhub-intl.tencentcloudmaas.com/plan/v3",
              "models": []
            }
          },
          {
            "value": "v5",
            "label": "Tencent Token Plan Enterprise Lite",
            "defaults": {
              "base_url": "https://tokenhub.tencentmaas.com/plan/v3",
              "models": []
            }
          },
          {
            "value": "v6",
            "label": "Tencent Token Plan Enterprise Lite (Intl)",
            "defaults": {
              "base_url": "https://tokenhub-intl.tencentcloudmaas.com/plan/v3",
              "models": []
            }
          }
        ]
      },
      {
        "name": "base_url",
        "type": "url",
        "label": "服务地址",
        "default": "https://api.lkeap.cloud.tencent.com/plan/v3"
      },
      {
        "name": "api_key",
        "type": "secret",
        "label": "API Key",
        "placeholder": "留空保留已保存密钥"
      },
      {
        "name": "key_env",
        "type": "text",
        "label": "或使用密钥环境变量"
      },
      {
        "name": "models",
        "type": "string_list",
        "label": "模型 ID（可选，逗号分隔；留空使用预设）"
      }
    ]
  },
  "setup": {
    "website": "https://opencode.ai/",
    "note": "独立 OpenCode 供应商配置；在主程序添加 Agent 界面填写本供应商凭据，不复用原版账号。首次引导可先跳过。"
